// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 20, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 5, // Gaps between modules (4px)
    // Choose the order of the modules
  "modules-left": [
  //    "hyprland/workspaces",
      "custom/menu",
          "cpu",
          "memory"
          //"temperature"
	  //"bluetooth"
  //    "hyprland/mode",
  //    "hyprland/scratchpad",
  //    "custom/media",
  ],
    "modules-center": [
	    "hyprland/workspaces",
	    "pulseaudio",
	    "backlight",
	    "power-profiles-daemon",
	    "battery",
	    "clock",
	    "hyprland/mode",
	    "network"

    ],
   "modules-right": [
    //"mpd",
    //"idle_inhibitor",
    //"pulseaudio",
    //"power-profiles-daemon",
    //"cpu",
    //"memory",
    //"temperature",
	    "hyprland/window",
    //"keyboard-state",
    //"hyprland/language",
    //"battery",
    //"battery#bat2",
          "tray",
    "custom/power"
   ],
    // Modules configuration
    "hyprland/workspaces": {
		"format": "{icon}",
        "all-outputs": true,
        "format-icons": {
		  "1": "",
		  "2": "",
		  "3": "",
		  "4": "",
		  "5": "",
		  "6": "6 : ",
		  "7": "7 : ",
		  "8": "8 : ",
		  "9": "9 : ",
		  "10": "10 : ",
		//"active": "",
		//"default": ""
		  "default": "~~"
    		},
        "persistent-workspaces": {
      		"*": 5
    		}
        },
"keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "hyprland/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "hyprland/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
         "icons": {
           "blueman": "bluetooth"
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
         }
    },
    "clock": {
        // "timezone": "America/New_York",
	"format" : "{0:%I :%M %p}",
        "tooltip-format": "<big>{:%d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%A,  %Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": true
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
	"interval" :10 ,
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": " ",
	"on-click-right":"nm-applet",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{essid} ",
        "format-linked": "{essid} ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr} ({signalStrength})%"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "{volume}%  {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [" ", " ", " "]
        },
        "on-click": "pavucontrol"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "VLC" : "",
            "default": "🎜"
        },
        "escape": true,
        "on-click": "/usr/bin/elisa" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "font-size": 21,
        "tooltip" : false,
      //"format" : "⏻ ",
        "format" : "  ",
	"on-click" : "wlogout"
    },

    "custom/menu": {
        "font-size": 31,
        "format" : "MENU ",
        "tooltip" : false,
	"on-click" : "wofi --show drun --allow-images"
    },
"hyprland/window": {
    "format": "{title}",
    "max-length":20,
        "font-size": 18,
    "separate-outputs": true
},

  "bluetooth": {
		"format": "",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"format-connected": "󰂱",
		"format-connected-battery": "󰂱",
		"tooltip-format": "Bluetooth: On",
		"tooltip-format-connected": "{device_alias}",
		"tooltip-format-disabled": "Bluetooth: Disabled",
		"tooltip-format-off": "Bluetooth: Off",
		"tooltip-format-no-controller": "No Bluetooth Adapter",
		"on-click": "blueman-manager",
		"on-click-middle": "rfkill toggle bluetooth"
	}

}
