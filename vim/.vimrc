" ~~Appearance~~
set number
syntax on
set cursorline          " Highlight the line where the cursor is
"set showmatch           " Highlight matching brackets (parentheses, etc.)
"set relativenumber      " Show distance from current line for easier jumping
"set scrolloff=8         " Keep 8 lines visible above/below cursor when scrolling

" ~~ Mouse ~~
set mouse=a

" ~~ Search ~~
set hlsearch            " Highlight all search results
set incsearch           " Jump to results immediately as you type
"set smartcase           " Use case-sensitive search only if uppercase is typed

" ~~ Indentation ~~
set autoindent          " Copy indent from current line to next
set smartindent         " Be smart about code blocks (e.g., after '{')
set expandtab           " Use spaces instead of tabs (best for Python/JS)
set shiftwidth=4        " Number of spaces for each auto-indent step
set tabstop=4           " Number of spaces a <Tab> represents

